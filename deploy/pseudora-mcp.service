[Unit]
Description=Pseudora MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=@@MCP_DIR@@
EnvironmentFile=@@MCP_ENV_FILE@@
ExecStart=@@MCP_DIR@@/.venv/bin/pii-mcp --transport streamable-http
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@MCP_DIR@@

[Install]
WantedBy=multi-user.target
