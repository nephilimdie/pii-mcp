[Unit]
Description=Pseudora MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/your/path/pii-mcp
EnvironmentFile=/etc/pseudora/pii-mcp.env
ExecStart=/opt/your/path/pii-mcp/.venv/bin/pii-mcp --transport streamable-http
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/your/path/pii-mcp

[Install]
WantedBy=multi-user.target
