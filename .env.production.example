# The remote MCP keeps no customer credential. Every client supplies its own
# token in Authorization: Bearer <Pseudora API key or OAuth access token>.
PSEUDORA_API_URL=https://pseudora.cloud
PSEUDORA_MCP_URL=https://mcp.pseudora.cloud
PSEUDORA_TIMEOUT_SECONDS=60

MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_AUTH_CACHE_TTL_SECONDS=30
MCP_ALLOWED_HOSTS=mcp.pseudora.cloud,localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=https://mcp.pseudora.cloud
